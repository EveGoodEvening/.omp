setupVersion: 1

dev:
  autoqa:
    consent: denied

symbolPreset: unicode
theme: 
  dark: dark-slate
  light: light

tools:
  approvalMode: yolo # always-ask, write, yolo

secrets: 
  enabled: true

modelRoles:
  default: cpa-responses/gpt-5.6-sol:low
  task: cpa-responses/glm:high
  smol: cpa-responses/glm:high
  commit: cpa-responses/glm:high
  tiny: cpa-responses/glm:high
  slow: cpa-responses/gpt-5.6-sol:medium
  plan: cpa-responses/gpt-5.6-sol:max
  designer: cpa-responses/gpt-5.6-sol:max
  advisor: cpa-responses/gpt-5.6-sol:max
enabledModels:
  - cpa-responses/gpt-5.6-sol
  - cpa-responses/gpt-5.6-terra
  - cpa-responses/gpt-5.6-luna
  - cpa-responses/gpt-5.5
  - cpa-responses/glm

defaultThinkingLevel: medium
hideThinkingBlock: true

disabledProviders:
# - claude-plugins   # Claude Code Marketplace
  - claude           # ~/.claude + .claude/
  - codex            # ~/.codex + .codex/
  - agents           # .agent / .agents/
  - opencode         # ~/.config/opencode + .opencode/
  - cursor
  - gemini
  - windsurf
  - cline
  - github
  - vscode

inspect_image: 
  enabled: true

providers:
  webSearch:
    - codex
    - brave
    - xai
    - public
    - duckduckgo
    - bing
    - yahoo
    - startpage
    - google
    - ecosia
    - mojeek
  imageOrder:
    - openai-codex
    - openai
    - xai
