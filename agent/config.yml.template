setupVersion: 1

dev:
  autoqa:
    consent: denied

symbolPreset: unicode
theme: 
  dark: dark-slate
  light: light

tools:
  approvalMode: yolo # always-ask, write, yolo

secrets: 
  enabled: true

modelRoles:
  default: cpa-responses/gpt-5.5:medium
  main: cpa-responses/gpt-5.5:medium
  task: cpa-responses/gpt-5.5:medium
  commit: cpa-responses/gpt-5.5:medium
  smol: cpa-responses/gpt-5.5:none
  slow: cpa-responses/gpt-5.5:xhigh
  plan: cpa-responses/gpt-5.5:xhigh
enabledModels:
 - cpa-responses/gpt-5.5
 - cpa-completions/kimi-k2p6-turbo

defaultThinkingLevel: medium
hideThinkingBlock: true

disabledProviders:
# - claude-plugins   # Claude Code Marketplace
  - claude           # ~/.claude + .claude/
  - codex            # ~/.codex + .codex/
  - agents           # .agent / .agents/
  - opencode         # ~/.config/opencode + .opencode/
  - cursor
  - gemini
  - windsurf
  - cline
  - github
  - vscode

inspect_image: 
  enabled: true

providers:
  webSearch: auto
